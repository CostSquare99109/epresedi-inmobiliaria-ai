# ============================================================
# inmobiliaria-ai configuration. Copy to .env and fill in.
# NEVER commit the real .env with secrets.
# ============================================================

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# --- Telegram -------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- NVIDIA Build (only external intelligence dependency) ------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# e.g. meta/llama-3.3-70b-instruct
NVIDIA_MODEL=
NVIDIA_TIMEOUT=60
# Ordered provider chain (comma separated). Only "nvidia" is implemented today;
# the chain exists so a second vendor can be added without touching app logic.
LLM_PROVIDERS=nvidia

# LLM_MODE semantics (the LLM is the brain, not an optional chat layer):
#   auto          → LLM-FIRST: NVIDIA orchestrates every turn (tools + reasoning).
#                   Deterministic pipeline only runs as per-turn FAILSAFE.
#   nvidia        → force the NVIDIA provider (fails if credentials are missing).
#   deterministic → never call the network; the deterministic pipeline is the brain.
LLM_MODE=auto

# LLM-first loop knobs (failure tolerance + cost control)
LLM_MAX_TOOL_ROUNDS=4
LLM_MAX_TOOL_CALLS_PER_TURN=8
LLM_HISTORY_TURNS=8
LLM_TOOL_RESULT_MAX_CHARS=4000
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000
LLM_RETRY_MAX=3
# Reasoning effort level for models that support it (high | medium | low | minimal | none)
LLM_REASONING_LEVEL=high

# auto = NVIDIA embeddings when NVIDIA is configured, local hashing otherwise
EMBEDDING_PROVIDER=auto
# dimension for pgvector column (local provider uses 256)
EMBEDDING_DIM=256

# --- Database (local PostgreSQL) --------------------------------
DATABASE_URL=postgresql+psycopg://inmobiliaria:inmobiliaria@127.0.0.1:5432/inmobiliaria
TEST_DATABASE_URL=postgresql+psycopg://inmobiliaria:inmobiliaria@127.0.0.1:5432/inmobiliaria_test
PGDATA=./pgdata

# --- Cache / jobs (local Redis) ---------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# --- Storage ----------------------------------------------------
STORAGE_PATH=./storage
DOCUMENTS_PATH=./documents
MAX_UPLOAD_MB=15

# --- Admin panel / internal API ----------------------------------
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3000
# Internal API admin auth token (generate with: openssl rand -hex 32)
ADMIN_TOKEN=changeme-admin-token
API_BASE_URL=http://127.0.0.1:8000

# --- UX -----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=20
TZ=America/Bogota
